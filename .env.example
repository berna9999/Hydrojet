# Copia questo file in ".env" per lo sviluppo locale e imposta gli stessi valori
# nelle Environment Variables del progetto Vercel. Non committare mai ".env".

# Chiave API di Resend (https://resend.com) usata dal modulo preventivo.
RESEND_API_KEY=

# Indirizzo email su cui HydroJet riceve le richieste di preventivo.
QUOTE_TO_EMAIL=

# Mittente delle email. Senza un dominio verificato su Resend usa
# "HydroJet <onboarding@resend.dev>" (consegna solo all'email del tuo account Resend).
QUOTE_FROM_EMAIL=HydroJet <onboarding@resend.dev>

# URL pubblico definitivo (es. https://www.hydrojet.it). Su Vercel, se assente,
# viene usato automaticamente il dominio di produzione del progetto.
SITE_URL=
