---
/** Intestazione e corpo per le pagine di solo testo (privacy, conferme, 404). */
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="text-hero on-dark">
  <div class="container text-hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="lead">{intro}</p>}
  </div>
</section>

<div class="container">
  <div class="prose">
    <slot />
  </div>
</div>

<style>
  .text-hero {
    padding-block: clamp(3rem, 7vw, 5rem);
    background:
      radial-gradient(70% 80% at 90% 0%, rgb(14 98 160 / 0.5), transparent 70%),
      var(--navy-950);
    color: var(--white);
  }

  .text-hero__inner {
    max-width: calc(48rem + var(--gutter) * 2);
  }

  .text-hero h1 {
    color: var(--white);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .text-hero .lead {
    margin-top: 1rem;
  }

  .prose {
    max-width: 48rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(4rem, 8vw, 6rem);
  }

  .prose :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p + p),
  .prose :global(ul) {
    margin-top: 0.875rem;
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
  }

  .prose :global(li + li) {
    margin-top: 0.4rem;
  }

  .prose :global(.btn) {
    margin-top: 2rem;
  }
</style>
