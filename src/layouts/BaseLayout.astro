---
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, areasLabel } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Prefisso dei link di navigazione ('' in home, '/' altrove). */
  base?: string;
  noindex?: boolean;
  /** Inserisce i dati strutturati LocalBusiness (solo in home). */
  structuredData?: boolean;
}

const {
  title = `${site.name} | Pulizia con idropulitrice a ${areasLabel}`,
  description = site.description,
  base = '',
  noindex = false,
  structuredData = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;
const logoUrl = new URL('/logo-hydrojet.png', Astro.site).href;

// Solo dati verificati: niente indirizzo, orari, recensioni o coordinate inventati.
const sameAs = [site.contact.instagram, site.contact.facebook].filter(Boolean);
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.description,
  url: new URL('/', Astro.site).href,
  logo: logoUrl,
  image: ogImage,
  areaServed: site.areas.map((name) => ({ '@type': 'City', name })),
  ...(site.contact.phones.length > 0 && { telephone: site.contact.phones[0].number }),
  ...(site.contact.email && { email: site.contact.email }),
  ...(site.legal.vatNumber && { vatID: site.legal.vatNumber }),
  ...(sameAs.length > 0 && { sameAs }),
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#051726" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — pulizia con idropulitrice a ${areasLabel}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <Header base={base} />
    <main id="contenuto">
      <slot />
    </main>
    <Footer base={base} />
    <slot name="after-footer" />
  </body>
</html>
